# GatePass — Environment Variables (template)
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Client-exposed variables MUST be prefixed `VITE_` (Vite only inlines those
# into the browser bundle). Everything else is server-only.

# ─── Runtime ─────────────────────────────────────────────────────────────────
# "development" | "production". In production the server fails fast if secrets
# are missing (see src/server/middleware/auth.ts) and enables Postgres SSL.
NODE_ENV=development

# Port the Express API listens on (src/server/index.ts). Default: 3001.
PORT=3001

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Postgres connection string. For Supabase use the connection-pooler URI from
# Project Settings → Database → Connection string (URI).
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/gatepass

# Postgres SSL (src/db/index.ts). SSL is ON automatically when NODE_ENV=production.
# For local dev against plain Postgres leave unset (SSL off). Set to "require"
# to force SSL locally, or "disable" to explicitly opt out (dev only).
DATABASE_SSL=
# Set to "false" only if your provider terminates TLS with a non-system CA
# (Supabase's pooler does). The connection stays encrypted; chain verification
# is relaxed. Leave unset/true otherwise.
DATABASE_SSL_REJECT_UNAUTHORIZED=

# ─── Supabase Auth (Phase 2) ─────────────────────────────────────────────────
# Server-side. Setting SUPABASE_URL switches the API into Supabase-verification
# mode: tokens are verified ASYMMETRICALLY against the project's public JWKS at
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (ES256/RS256) — there is NO
# shared JWT secret to configure (see src/server/auth/supabase-jwt.ts).
# The role for authorization is ALWAYS read from our own `guards` table —
# NEVER from Supabase user metadata or JWT custom claims (see ADR 0001).
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role (secret) key. NOT read by the running app — used only for
# admin operations (e.g. seeding pre-confirmed test users via the Supabase
# Admin API). Optional for just running the app; keep server-side only, never VITE_.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-secret-key>

# Client-side (browser) Supabase config for the login UI. The anon key is
# safe to expose to the browser. Use the BASE project URL (no /rest/v1 suffix).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# ─── Legacy / dev auth (being replaced by Supabase in Phase 2) ───────────────
# Self-issued JWT signing secret. Still used until Supabase verification lands.
# REQUIRED in production (server refuses to start with the dev fallback).
JWT_SECRET=change-me-to-a-strong-secret-in-production
# Dev convenience: a pre-minted bearer token injected by the API client when no
# session exists. Leave empty once real login (Supabase) is wired up.
VITE_DEV_JWT=

# ─── API client ──────────────────────────────────────────────────────────────
# Base URL the frontend uses to reach the API (src/lib/api/client.ts).
VITE_API_BASE_URL=http://localhost:3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins (src/server/app.ts). No wildcards.
# Defaults to localhost dev origins when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Feature config ────────────────────────────────────────────────────────────
# Resident approval timeout in seconds (src/server/services/approval-service.ts).
APPROVAL_TIMEOUT_SECONDS=300
# Public origin used to build resident magic-links / visitor QR pass URLs.
APP_PUBLIC_ORIGIN=http://localhost:5173
